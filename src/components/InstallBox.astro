---
interface Props {
  command: string | null;
  label?: string;
  /** Slug identifying what's being installed — e.g. "dev-expert" or "openclaw/github" */
  trackingSlug?: string;
}

const { command, label = 'Install', trackingSlug } = Astro.props;
---

{command ? (
  <div>
    <span class="install-label">{label}</span>
    <div class="install-box">
      <span class="install-command">{command}</span>
      <button
        class="copy-btn"
        aria-label="Copy install command"
        data-command={command}
        data-tracking-slug={trackingSlug}
      >
        Copy
      </button>
    </div>
  </div>
) : (
  <div>
    <span class="install-label">No install command detected</span>
    <div class="install-box degraded">
      <span class="install-command" style="color: var(--text-muted)">See full usage below ↓</span>
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    if (btn.dataset.copyBound) return;
    btn.dataset.copyBound = '1';
    btn.addEventListener('click', async () => {
      const command = btn.dataset.command ?? '';
      btn.classList.remove('copied', 'error');

      try {
        await navigator.clipboard.writeText(command);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        // Track install conversion
        const slug = btn.dataset.trackingSlug;
        if (slug) {
          fetch('/api/track-install', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
            keepalive: true,
          }).catch(() => {}); // fire-and-forget — never block the UI
        }
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      } catch {
        // Clipboard API unavailable — show a select-all input
        btn.classList.add('error');
        btn.textContent = 'Copy';
        const input = document.createElement('input');
        input.value = command;
        input.style.cssText = `
          position: absolute; opacity: 0; pointer-events: none;
        `;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
      }
    });
  });
</script>
